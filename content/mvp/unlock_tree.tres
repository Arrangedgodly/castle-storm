[resource]
script = ExtResource("3_tree")
version = 1
nodes = Array[ExtResource("2_node")]([SubResource("UnlockNode_grandmas_recipes"), SubResource("UnlockNode_the_seed_drawer"), SubResource("UnlockNode_the_emergency_cheese"), SubResource("UnlockNode_unpaid_artisans"), SubResource("UnlockNode_cousin_ironmonger"), SubResource("UnlockNode_the_masons_secret"), SubResource("UnlockNode_the_smiths_signature"), SubResource("UnlockNode_the_salvage_charter"), SubResource("UnlockNode_the_sergeants_primer"), SubResource("UnlockNode_the_drill_song_book"), SubResource("UnlockNode_the_sand_yard"), SubResource("UnlockNode_war_games_on_sundays")])
branch_crests = Dictionary[StringName, StringName]({
&"old_guard": &"crest_old_guard",
&"workshop": &"crest_workshop",
&"yard": &"crest_yard"
})

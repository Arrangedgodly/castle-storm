[gd_resource type="Resource" script_class="CopyTable" format=3]

[ext_resource type="Script" path="res://content/schema/copy_table.gd" id="1_c"]

[resource]
script = ExtResource("1_c")
templates = Dictionary[StringName, PackedStringArray]({
&"assault_casualties": PackedStringArray("{count} of the vanguard fall at the walls.", "{count} of ours fall. The wall is unmoved."),
&"assault_denied": PackedStringArray("Refused — the knight floor stands ({power} power).", "The clerk refuses: {power} power, the floor unmet."),
&"assault_lost": PackedStringArray("The assault breaks against {regime}'s walls.", "{regime} holds. The ladders did not."),
&"assault_loss_block": PackedStringArray("THE ASSAULT IS BROKEN under {regime}.", "THE ASSAULT IS BROKEN. {regime} keeps its walls and its tone."),
&"assault_loss_note": PackedStringArray("{count} of the vanguard lie where they fell. The plot survives.", "{count} fell at the walls. The Crown's clerks took names."),
&"assault_win_bank": PackedStringArray("{points} legacy points pass to the next hand.", "The bank records {points} points. The next hand will need them."),
&"assault_win_block": PackedStringArray("THE CASTLE FALLS. {regime} is undone.", "THE CASTLE FALLS. {regime} is struck from the doors."),
&"autosave_filed": PackedStringArray("The hour is filed at {hours}h — the hand is kept safe.", "The clerk blots the hour at {hours}h — nothing is lost."),
&"beat_advance": PackedStringArray("The army advances through the mud to the walls.", "The column advances. The mud has opinions.", "They advance on the walls, in step, more or less."),
&"beat_gate": PackedStringArray("The gate is reached. The ram does its arithmetic.", "The ram reaches the gate and begins its sums."),
&"beat_gate_fallen": PackedStringArray("The gate holds; the ram insists — {count} more fall.", "The gate's arithmetic: {count} more of ours subtracted."),
&"beat_rout": PackedStringArray("The army breaks and runs for the tree line.", "The army breaks. The tree line seems wise.", "The rout reaches the tree line before the news does."),
&"beat_skirmish": PackedStringArray("Skirmish beneath the walls; both ledgers bleed.", "Skirmish at the walls. Nobody agrees who started it."),
&"beat_skirmish_fallen": PackedStringArray("Skirmish beneath the walls — {count} of ours fall.", "The skirmish costs {count}. The walls do not pay."),
&"beat_throne": PackedStringArray("The throne room is taken. The seal changes hands.", "The throne room falls. Someone bows, quickly.", "The throne is taken. The cushions survive."),
&"building_built": PackedStringArray("The {building} rises — level 1.", "A {building} stands where nothing did."),
&"building_milestone": PackedStringArray("The {building} hits a milestone — the rates double.", "The {building} doubles its rates. The clerks weep."),
&"building_upgraded": PackedStringArray("The {building} grows to level {level}.", "The {building} gains a level ({level}). The carpenter gains pride."),
&"card_telegraph_line": PackedStringArray("Riders count barns.", "A warrant is signed.", "Hoofbeats. Official."),
&"card_warn_line": PackedStringArray("Underlined. Twice.", "Your name, in best ink.", "Page two of a list."),
&"cards_kept_close": PackedStringArray("The conspirators keep the cards close, the lamps low.", "They keep the cards close and say nothing."),
&"catch_up_clock_rewound": PackedStringArray("The castle clock was found wound backwards.", "The castle clock ran backwards. Nothing was said, loudly."),
&"catchup_away_capped": PackedStringArray("You were away {duration} — the clock stops at {hours} hours.", "{duration} away; the clock remembers only {hours}."),
&"catchup_away_empty": PackedStringArray("The table kept its counsel while you were gone.", "Nothing changed while you were gone. Officially."),
&"catchup_away_plain": PackedStringArray("You were away {duration}; the press kept printing.", "You were away {duration}. The press did not pause."),
&"catchup_capped": PackedStringArray("The crown's clock stops at {hours} hours; the rest is lost.", "The crown's clock stops at {hours} hours; it kept the rest."),
&"catchup_crackdown_strike": PackedStringArray("A crackdown landed while you were away.", "Riders came and collected while you were away."),
&"catchup_headline": PackedStringArray("While you were away, {duration} passed at the table.", "{duration} passed at the table while you were away."),
&"catchup_people_arrived": PackedStringArray("{count} came to the gate", "{count} waited at the gate"),
&"catchup_people_drills": PackedStringArray("{count} finished drills", "{count} completed their drills"),
&"catchup_people_promoted": PackedStringArray("{count} {verb} promoted", "{count} {verb} raised in rank"),
&"catchup_quiet": PackedStringArray("You were away a moment; the table kept still.", "You stepped out a moment. Nothing moved."),
&"catchup_rewound": PackedStringArray("The clock was wound backwards. Nothing was lost.", "The clock was wound backwards. The steward saw nothing."),
&"catchup_run_ended": PackedStringArray("The hand itself ended while you were away."),
&"catchup_stores": PackedStringArray("The stores: {stores}.", "Moved: {stores}."),
&"catchup_stores_quiet": PackedStringArray("The stores kept their count.", "Nothing was added; nothing was taken."),
&"catchup_suspicion_ease": PackedStringArray("The Crown's eye: {before} to {after} — it eased.", "The Crown's eye eased: {before} to {after}."),
&"catchup_suspicion_rise": PackedStringArray("The Crown's eye: {before} to {after} — it draws closer.", "The Crown's eye rose: {before} to {after}."),
&"chip_dismiss": PackedStringArray("Send the {count} loiterers home", "Send {count} home with thanks"),
&"chip_keep": PackedStringArray("Keep the cards close", "Fold the hand, quietly"),
&"chronicle_empty_1": PackedStringArray("the chronicle is blank — no dream has yet dared", "the chronicle is blank — the press waits anyway"),
&"chronicle_empty_2": PackedStringArray("The first hand is still on the table.", "One hand, one peasant, everything still to lose."),
&"clerk_denied": PackedStringArray("The clerk refuses the paperwork (reason {reason}).", "Denied by the clerk: form incomplete (reason {reason})."),
&"command_rejected": PackedStringArray("A command falls on deaf ears: {command}.", "Nothing happened. The clerk blames '{command}'."),
&"crackdown_cancelled": PackedStringArray("The riders turn back. Whoever paid them lost their nerve.", "The riders turn back at the ford. The warrant expires, unexecuted.", "The riders turn back. Nobody will admit they were coming."),
&"crackdown_scattered": PackedStringArray("…{count} recruits take up farming, urgently.", "…{count} recruits discover relatives in other counties.", "…{count} recruits leave notes. The notes are misspelled."),
&"crackdown_seized": PackedStringArray("…{count} {resource} marched off under royal seal.", "…{count} {resource} 'requisitioned' by the Crown.", "…{count} {resource} left, on official business."),
&"crackdown_struck": PackedStringArray("CRACKDOWN #{count}: ledgers seized, gate kicked.", "CRACKDOWN #{count} lands. Officials saw nothing.", "CRACKDOWN #{count}. The paperwork was flawless."),
&"crush_bank": PackedStringArray("The bank keeps what fire cannot: {points} points.", "{points} legacy points banked. The next hand inherits."),
&"crush_chronicle": PackedStringArray("The revolution is crushed. The chronicle remembers.", "The revolution is crushed. Records survive."),
&"crush_regime": PackedStringArray("{regime} closes its hand. The barns burn.", "{regime} files the dream as 'resolved'.", "{regime} calls it peace. It is well paid."),
&"daysheet_empty_1": PackedStringArray("the day-sheet is blank — no print this hand yet", "the page is blank — the hand has said nothing so far"),
&"daysheet_empty_2": PackedStringArray("The first print of the hand will head the page.", "Every line this hand prints gathers here."),
&"first_gate": PackedStringArray("New paper at the gate — touch {name}'s card to answer.", "A name prints at the gate: {name}. Touch the card."),
&"first_assign": PackedStringArray("Idle hands, honest work — touch {name}'s card: chores or drills.", "{name} waits on the table. Touch the card to set the hands."),
&"first_build": PackedStringArray("The stipend buys foundations — raise the {building}.", "The plots are staked; the coffers cover the {building}."),
&"first_train": PackedStringArray("{name} joins the drill line — the conspiracy counts soldiers.", "The yard takes {name}. One hand at a time, an army."),
&"first_trickle": PackedStringArray("The stores tally the first {resource}: +{amount}.", "First fruits, small and honest: +{amount} {resource}."),
&"gate_thinned": PackedStringArray("The gate thins: {count} sent home, thanked, unpaid.", "The gate thins — {count} loiterers sent home kindly."),
&"gear_equipped": PackedStringArray("{name} takes up the {gear}.", "{name} buckles on the {gear}. It fits, mostly."),
&"intro_first_line1": PackedStringArray("A blank chronicle, a warm press. One peasant steps up.", "Blank chronicle, warm press — someone goes first."),
&"intro_first_marks": PackedStringArray("Marked by the press: {tags}.", "The press notes: {tags}."),
&"intro_first_serve": PackedStringArray("You serve {regime}, as peasants do. For now.", "Every peasant serves {regime}. For now."),
&"intro_loss_remembers": PackedStringArray("The regime remembers; the bank too: {points} points safe."),
&"intro_loss_revenge": PackedStringArray("{regime} crushed {first}'s dream.", "The crest that crushed {first} deals your hand.", "Same crest, same walls. They crushed {first}."),
&"intro_loss_serve": PackedStringArray("You serve {regime}: the crest that did it.", "You serve {regime} still. Be quieter."),
&"intro_resumed_ended": PackedStringArray("The hand ended while you were away.", "The hand is over. It ended without you."),
&"intro_resumed_hold": PackedStringArray("{first} keeps the standard — hour {hours}.", "Hour {hours}: {first} still holds the standard."),
&"intro_resumed_next": PackedStringArray("The next hand waits beneath.", "The next hand is waiting. It always is."),
&"intro_resumed_tail": PackedStringArray("The spread waits beneath — the chronicle has the rest.", "The table waits beneath, exactly as you left it."),
&"intro_win_bank": PackedStringArray("The bank remembers: {points} points across {hands}.", "{points} points across {hands}, kept for the next leader."),
&"intro_win_context": PackedStringArray("{leader} took the castle at {hours}h. You were not fed.", "{leader} took the castle at {hours}h. Lovely feast."),
&"intro_win_kept": PackedStringArray("The banner never left: {regime} keeps your ink.", "{regime} keeps the ink your army won it."),
&"intro_win_swap": PackedStringArray("The castle changes ink — {new} over the old.", "{new} prints over the old crest tonight."),
&"prefs_kept": PackedStringArray("The clerk keeps these across hands.", "What is set here is kept, hand after hand."),
&"prefs_motion_full": PackedStringArray("Full turn"),
&"prefs_motion_note": PackedStringArray("Steady: the papers move less, and nothing is lost.", "Steady: the table keeps still; the news still prints."),
&"prefs_motion_steady": PackedStringArray("Steady hand"),
&"prefs_type_note": PackedStringArray("The size of the hand, for tired eyes.", "Set the letter size the eye prefers."),
&"primer_lineform": PackedStringArray("Dashed: work in hand. Solid: settled. Struck: lost.", "Dashed, in progress; solid, settled; struck, lost."),
&"recruit_accepted": PackedStringArray("{name} joins the conspiracy.", "{name} swears the oath. Nobody wrote it down.", "{name} is one of us now, whatever that means."),
&"recruit_arrived": PackedStringArray("{name} arrives at the gate, hat in hand.", "{name} arrives at the gate, asking few questions.", "{name} turns up at the gate with strong opinions."),
&"recruit_dismissed": PackedStringArray("{name} is sent home with kind words and no bread.", "{name} goes home, thanked extensively."),
&"resources_granted": PackedStringArray("The stipend arrives: {count} {resource}.", "The stipend: {count} {resource}, counted twice."),
&"run_aborted": PackedStringArray("The standard is folded up and buried. {points} banked.", "The standard is quietly buried. {points} points kept."),
&"run_crushed": PackedStringArray("The revolution is crushed. The chronicle remembers.", "It is crushed. An official calls it 'restoring order'.", "The dream is crushed by its own paperwork. The bank survives."),
&"run_lost": PackedStringArray("The hand collapses. The bank keeps {points} points.", "The hand collapses; {points} points survive it."),
&"run_restarted": PackedStringArray("A new hand is dealt: {first} under {regime}.", "Dealt again: {first}, still under {regime}."),
&"run_started": PackedStringArray("{first} raises the standard under {regime}.", "{first} takes up the standard under {regime}."),
&"run_won": PackedStringArray("The castle falls. {points} legacy points banked.", "The castle falls. The bank takes {points} points for the record."),
&"scatter_none": PackedStringArray("The gate was already thin; the riders find only mud."),
&"scatter_peasants": PackedStringArray("…{count} loitering peasants follow them.", "…{count} idle peasants trail after, regretting it later."),
&"scatter_row": PackedStringArray("Swept: {who} and {count} more board carts.", "{who} — swept, with {count} more."),
&"suspicion_rose": PackedStringArray("The Crown's clerks note +{points} from {source}.", "+{points} suspicion. Someone wrote it down. {source}, officially."),
&"suspicion_telegraph": PackedStringArray("The Eye turns: riders count your barns. Crackdown in {hours}h.", "Warrant signed, horses saddled — the crackdown lands in {hours}h.", "The riders know the way now. {hours} hours, they are told."),
&"suspicion_warn": PackedStringArray("Somewhere in the capital, a clerk underlines your name. Twice.", "A minor clerk adds your name to a list, in his best ink.", "The Crown's clerks inventory threats. Your barn is page two."),
&"telegraph_context": PackedStringArray("Thin the crowd.", "Let the ink dry."),
&"training_complete": PackedStringArray("{name} finishes the {rank} drills.", "The {rank} drills are done. {name} stands straighter."),
&"training_started": PackedStringArray("{name} begins training as {rank}.", "{name} reports for {rank} drills, sober-ish."),
&"title_begin": PackedStringArray("Deal the first hand"),
&"title_continue": PackedStringArray("Continue the hand"),
&"title_flavor": PackedStringArray("One press, one conspiracy. The castle will not storm itself.", "The press is warm; the table is bare. Someone goes first."),
&"title_flavor_return": PackedStringArray("The table is cleared. The next hand waits.", "The press remembers every hand. Deal another."),
&"title_hold": PackedStringArray("{first} keeps the standard — hour {hours}.", "The hand lives: {first}, hour {hours}."),
&"title_new_run": PackedStringArray("Deal a new hand"),
&"title_new_run_armed": PackedStringArray("Bury the live hand"),
&"title_new_run_caution": PackedStringArray("The hand ends where it stands; the bank keeps its points.", "Ending it banks what it earned. The chronicle will say so."),
&"title_next": PackedStringArray("Deal the next hand"),
&"unit_promoted": PackedStringArray("{name} is struck off the rolls as {rank} — {count} now.", "{name} turns over: a {rank}. The count reads {count}."),
&"unlock_branch_old_guard": PackedStringArray("The Old Guard"),
&"unlock_branch_workshop": PackedStringArray("The Workshop"),
&"unlock_branch_yard": PackedStringArray("The Yard"),
&"unlock_flavor_cousin_ironmonger": PackedStringArray("The family price is a threat and a discount."),
&"unlock_flavor_grandmas_recipes": PackedStringArray("Boots march on pickled eggs, banners or no."),
&"unlock_flavor_the_drill_song_book": PackedStringArray("The verses keep the step; the step keeps men."),
&"unlock_flavor_the_emergency_cheese": PackedStringArray("One wheel, shield-sized, older than the crest."),
&"unlock_flavor_the_masons_secret": PackedStringArray("Walls go up crooked, on purpose, for less."),
&"unlock_flavor_the_salvage_charter": PackedStringArray("Every burned barn is a discount, in writing."),
&"unlock_flavor_the_sand_yard": PackedStringArray("Falls in sand teach what falls in mud cost."),
&"unlock_flavor_the_seed_drawer": PackedStringArray("Grain hidden from three crowns, now lent out."),
&"unlock_flavor_the_sergeants_primer": PackedStringArray("Shouting is free; brevity has to be drilled."),
&"unlock_flavor_the_smiths_signature": PackedStringArray("Half the invoice. Twice the embossing."),
&"unlock_flavor_unpaid_artisans": PackedStringArray("Dues are waived. Nails, regrettably, are not."),
&"unlock_flavor_war_games_on_sundays": PackedStringArray("The crown rests on Sundays. The drills do not."),

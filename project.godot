; Engine configuration file.
; Castle Storm — pinned to Godot 4.7.2-stable, standard (GDScript) build, Compatibility renderer (R1).
; Root content-scale settings per R3 decision 3: 720x720 square base, canvas_items + expand, sensor orientation.

config_version=5

[application]

config/name="Castle Storm"
config/description="A satirical medieval revolution idle/roguelite. Build the conspiracy, storm the castle, inherit the aftermath."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7.2", "GL Compatibility")
config/icon="res://icon.svg"

[castle_storm]

; T-UI-04 motion seam: shorten the promotion flip and entrance slides to
; near-instant (the reveal stays — same signals, same end state). The
; future settings screen writes this via MotionProfile.forced; until then
; it is the project-level default.
motion/reduced_motion=false
; T-QA-05 type-scale seam: multiplies every theme font size (and the text
; panel budgets that grow with them) — supported range 1.0-1.3, applied at
; boot by ui/theme/type_scale.gd (see docs/acceptance-sweep.md for the
; range evidence).
type/scale=1.0

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gui]

theme/custom="res://ui/theme/spread_theme.tres"

[input]

